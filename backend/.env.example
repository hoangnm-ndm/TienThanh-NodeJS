# Môi trường chạy: development | production (production bật cookie secure)
NODE_ENV=
# Cổng HTTP (mặc định 8000)
PORT=
# Chuỗi kết nối MongoDB (bắt buộc)
DB_URI=
# Mức log pino: fatal | error | warn | info | debug | trace (mặc định info)
LOG_LEVEL=

# Số vòng salt bcrypt khi hash mật khẩu (mặc định 10)
BCRYPT_SALT_ROUNDS=

# Secret ký access token (bắt buộc, chuỗi ngẫu nhiên dài, khác refresh secret)
JWT_ACCESS_SECRET=
# Thời hạn access token: 30s | 15m | 1h | 7d (mặc định 15m)
JWT_ACCESS_EXPIRES_IN=
# Secret ký refresh token (bắt buộc, chuỗi ngẫu nhiên dài)
JWT_REFRESH_SECRET=
# Thời hạn refresh token / session (mặc định 7d)
JWT_REFRESH_EXPIRES_IN=

# Domain gắn cho cookie auth (để trống = domain hiện tại)
COOKIE_DOMAIN=

# Email superAdmin tạo bởi npm run db:seed (để trống = bỏ qua seed superAdmin)
SEED_SUPER_ADMIN_EMAIL=
# Mật khẩu superAdmin khi seed tạo user mới (cùng rule mật khẩu đăng ký)
SEED_SUPER_ADMIN_PASSWORD=
