{
  "name": "tienthanh",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo TienThanh: backend (Express + MongoDB), frontend (React + Vite), docs",
  "type": "module",
  "author": "hoangnm",
  "license": "MIT",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm install && npm run env:sync",
    "env:sync": "node scripts/env-sync.mjs",
    "dev": "concurrently -k -n be,fe -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "start": "npm run start -w backend",
    "db:seed": "npm run db:seed -w backend",
    "build": "npm run build -w frontend",
    "preview": "npm run preview -w frontend",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
